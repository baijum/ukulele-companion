    "settings_auto_advance_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights the next untuned string automatically"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en évidence automatiquement la prochaine corde non accordée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert automatisch die nächste ungestimmte Saite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalta automáticamente la siguiente cuerda sin afinar"
          }
        },
