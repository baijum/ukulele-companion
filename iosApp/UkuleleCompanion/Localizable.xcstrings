    "scale_practice_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice scales with guided play-along, quizzes, and ear training."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratiquez les gammes avec accompagnement guidé, quiz et entraînement auditif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe Tonleitern mit geführtem Mitspielen, Quiz und Gehörtraining."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica escalas con guía interactiva, quizzes y entrenamiento auditivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati con le scale tramite riproduzione guidata, quiz ed ear training."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique escalas com acompanhamento guiado, quizzes e treino auditivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen toonladders met begeleiding, quizzen en gehoortraining."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Практикуйте гаммы с направленной игрой, тестами и тренировкой слуха."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberli çalma, testler ve kulak eğitimi ile dizileri çalışın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz gamy z prowadzeniem, quizami i treningiem słuchu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド付き演奏、クイズ、聴音トレーニングでスケールを練習しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드 연주, 퀴즈, 청음 훈련으로 스케일을 연습하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गाइडेड प्ले-अलॉन्ग, क्विज़ और कान प्रशिक्षण से स्केल का अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih tangga nada dengan panduan bermain, kuis, dan latihan pendengaran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرن على السلالم مع العزف المصاحب الموجه والاختبارات وتدريب الأذن."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过引导跟弹、测验和听力训练来练习音阶。"
          }
        }
      }
    },
