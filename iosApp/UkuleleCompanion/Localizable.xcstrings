    "restore_dialog_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will merge favorites, songs, progressions, and patterns from the backup file with your existing data. Settings will be replaced with the backup values.\\n\\nYour existing data will not be deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci fusionnera les favoris, chansons, progressions et motifs du fichier de sauvegarde avec vos données existantes. Les paramètres seront remplacés par les valeurs de la sauvegarde.\\n\\nVos données existantes ne seront pas supprimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies führt Favoriten, Songs, Akkordfolgen und Muster aus der Sicherungsdatei mit deinen vorhandenen Daten zusammen. Einstellungen werden durch die Sicherungswerte ersetzt.\\n\\nDeine vorhandenen Daten werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto combinará los favoritos, canciones, progresiones y patrones del archivo de respaldo con tus datos existentes. Los ajustes se reemplazarán con los valores del respaldo.\\n\\nTus datos existentes no se eliminarán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione unirà preferiti, brani, progressioni e pattern dal file di backup con i dati esistenti. Le impostazioni saranno sostituite con i valori del backup.\\n\\nI dati esistenti non verranno eliminati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto combinará os favoritos, músicas, progressões e padrões do arquivo de backup com seus dados existentes. As configurações serão substituídas pelos valores do backup.\\n\\nSeus dados existentes não serão excluídos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal favorieten, liedjes, progressies en patronen uit het back-upbestand samenvoegen met je bestaande gegevens. Instellingen worden vervangen door de back-upwaarden.\\n\\nJe bestaande gegevens worden niet verwijderd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранное, песни, прогрессии и ритмы из файла будут объединены с вашими текущими данными. Настройки будут заменены значениями из резервной копии.\\n\\nВаши текущие данные не будут удалены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem yedek dosyasındaki favorileri, şarkıları, ilerleme ve kalıpları mevcut verilerinizle birleştirecek. Ayarlar yedekteki değerlerle değiştirilecek.\\n\\nMevcut verileriniz silinmeyecek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione, piosenki, progresje i wzorce z pliku kopii zapasowej zostaną scalone z istniejącymi danymi. Ustawienia zostaną zastąpione wartościami z kopii zapasowej.\\n\\nIstniejące dane nie zostaną usunięte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップファイルのお気に入り、曲、コード進行、パターンが既存のデータと統合されます。設定はバックアップの値に置き換えられます。\\n\\n既存のデータは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 파일의 즐겨찾기, 곡, 코드 진행, 패턴이 기존 데이터와 병합됩니다. 설정은 백업 값으로 대체됩니다.\\n\\n기존 데이터는 삭제되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप फ़ाइल से पसंदीदा, गाने, प्रोग्रेशन और पैटर्न को आपके मौजूदा डेटा के साथ मर्ज करेगा। सेटिंग्स बैकअप मानों से बदली जाएँगी।\\n\\nआपका मौजूदा डेटा हटाया नहीं जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menggabungkan favorit, lagu, progresi, dan pola dari file cadangan dengan data Anda yang ada. Pengaturan akan diganti dengan nilai dari cadangan.\\n\\nData Anda yang ada tidak akan dihapus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم دمج المفضلة والأغاني والتقدمات اللحنية والأنماط من ملف النسخ الاحتياطي مع بياناتك الحالية. سيتم استبدال الإعدادات بقيم النسخ الاحتياطي.\\n\\nلن يتم حذف بياناتك الحالية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将把备份文件中的收藏、歌曲、和弦进行和节奏型与你现有的数据合并。设置将被备份中的值替换。\\n\\n你现有的数据不会被删除。"
          }
        }
      }
    },
