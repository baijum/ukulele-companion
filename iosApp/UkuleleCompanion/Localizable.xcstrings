    "routine_ear_training_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد الفواصل وأنواع الأوتار بالأذن. ركّز على الحصول على 70%% صحيح على الأقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne Intervalle und Akkordtypen nach Gehör. Ziel: mindestens 70%% richtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identify intervals and chord types by ear. Focus on getting at least 70%% correct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica intervalos y tipos de acordes de oído. Intenta acertar al menos el 70%%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiez les intervalles et types d'accords à l'oreille. Visez au moins 70%% de bonnes réponses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कान से इंटरवल और कॉर्ड प्रकार पहचानें। कम से कम 70%% सही पाने पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifikasi interval dan jenis akor dengan pendengaran. Fokus pada minimal 70%% benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica intervalli e tipi di accordi a orecchio. Concentrati su almeno 70%% di risposte corrette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳で音程とコードタイプを識別。70%%以上の正解を目指す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀로 음정과 코드 유형을 구분하세요. 70%% 이상 정답을 목표로 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herken intervallen en akkoordtypes op gehoor. Richt je op minimaal 70%% correct."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawaj interwały i typy akordów na słuch. Skup się na co najmniej 70%% poprawności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificar intervalos e tipos de acordes de ouvido. Foque em acertar pelo menos 70%%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяйте интервалы и типы аккордов на слух. Стремитесь к точности не менее 70%%."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aralıkları ve akor türlerini kulakla belirleyin. En az 70%% doğru hedefleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用耳朵辨认音程和和弦类型。争取至少 70%% 正确。"
          }
        }
      }
    },
