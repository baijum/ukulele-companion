          "stringUnit" : {
            "state" : "translated",
            "value" : "Esercitati davanti a uno specchio per controllare la posizione delle mani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鏡の前で練習して、手の位置を確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거울 앞에서 연습하며 손 자세를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oefen voor een spiegel om je handpositie te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ćwicz przed lustrem, aby sprawdzić pozycję rąk."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique na frente de um espelho para verificar a posição da mão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занимайтесь перед зеркалом, чтобы контролировать положение руки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pozisyonunuzu kontrol etmek için ayna karşısında çalışın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对着镜子练习以检查手部姿势。"
          }
        }
      }
    },
    "daily_tip_6" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ركز على الانتقالات السلسة بدلاً من السرعة — السرعة تأتي مع الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konzentriere dich auf fließende Übergänge statt auf Geschwindigkeit — die kommt mit der Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on smooth transitions rather than speed — speed comes with time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concéntrate en transiciones suaves en lugar de velocidad — la velocidad viene con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrez-vous sur des transitions fluides plutôt que sur la vitesse — la vitesse viendra avec le temps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गति के बजाय सहज ट्रांज़िशन पर ध्यान दें — गति समय के साथ आती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus pada transisi yang mulus daripada kecepatan — kecepatan akan datang seiring waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrati sulle transizioni fluide piuttosto che sulla velocità — la velocità arriverà con il tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピードより滑らかな移行に集中しましょう — 速さは後からついてきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속도보다 부드러운 전환에 집중하세요 — 속도는 나중에 따라옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt je op vloeiende overgangen in plaats van snelheid — snelheid komt met de tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skup się na płynnych przejściach, a nie na szybkości — szybkość przyjdzie z czasem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foque em transições suaves em vez de velocidade — a velocidade vem com o tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стремитесь к плавным переходам, а не к скорости — скорость придёт со временем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızdan çok akıcı geçişlere odaklanın — hız zamanla gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于流畅的转换而不是速度——速度会随时间自然提升。"
          }
        }
      }
    },
