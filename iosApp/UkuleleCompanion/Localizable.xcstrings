            "value" : "احفظ جميع بياناتك (المفضلة، الأغاني، التقدمات اللحنية، الأنماط، الإعدادات، وتقدم التعلم) في ملف، أو استعد من نسخة احتياطية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere alle deine Daten (Favoriten, Songs, Akkordfolgen, Muster, Einstellungen und Lernfortschritt) in einer Datei oder stelle sie aus einer Sicherung wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your data (favorites, songs, progressions, patterns, settings, and learning progress) to a file, or restore from a backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todos tus datos (favoritos, canciones, progresiones, patrones, ajustes y progreso de aprendizaje) en un archivo, o restaura desde una copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez toutes vos données (favoris, chansons, progressions, motifs, paramètres et progression d'apprentissage) dans un fichier, ou restaurez à partir d'une sauvegarde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना सारा डेटा (पसंदीदा, गाने, प्रोग्रेशन, पैटर्न, सेटिंग्स और सीखने की प्रगति) एक फ़ाइल में सहेजें, या बैकअप से रिस्टोर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan semua data Anda (favorit, lagu, progresi, pola, pengaturan, dan kemajuan belajar) ke file, atau pulihkan dari cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva tutti i tuoi dati (preferiti, brani, progressioni, pattern, impostazioni e progressi di apprendimento) in un file, oppure ripristina da un backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデータ（お気に入り、曲、コード進行、パターン、設定、学習進捗）をファイルに保存したり、バックアップから復元したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 데이터(즐겨찾기, 곡, 코드 진행, 패턴, 설정, 학습 진행 상황)를 파일로 저장하거나 백업에서 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla al je gegevens op (favorieten, liedjes, progressies, patronen, instellingen en leervoortgang) in een bestand, of herstel vanuit een back-up."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz wszystkie dane (ulubione, piosenki, progresje, wzorce, ustawienia i postępy nauki) do pliku lub przywróć z kopii zapasowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve todos os seus dados (favoritos, músicas, progressões, padrões, configurações e progresso de aprendizado) em um arquivo, ou restaure a partir de um backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните все данные (избранное, песни, прогрессии, ритмы, настройки и прогресс обучения) в файл или восстановите из резервной копии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm verilerinizi (favoriler, şarkılar, ilerlemeler, kalıplar, ayarlar ve öğrenme ilerlemesi) bir dosyaya kaydedin veya bir yedekten geri yükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的所有数据（收藏、歌曲、和弦进行、节奏型、设置和学习进度）保存到文件，或从备份中恢复。"
          }
        }
      }
    },
