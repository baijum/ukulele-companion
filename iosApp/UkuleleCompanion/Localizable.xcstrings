    "daily_tip_1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى 5 دقائق من التمرين اليومي أفضل من ساعة واحدة أسبوعياً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst 5 Minuten tägliches Üben sind besser als 1 Stunde pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even 5 minutes of daily practice is better than 1 hour once a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso 5 minutos de práctica diaria son mejores que 1 hora una vez a la semana."
