    "favorites_delete_folder_msg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete folder \\\"%@\\\"? Voicings in this folder will not be deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le dossier \\\"%@\\\" ? Les voicings de ce dossier ne seront pas supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner \\\"%@\\\" löschen? Voicings in diesem Ordner werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar la carpeta \\\"%@\\\"? Los voicings de esta carpeta no se eliminarán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare la cartella \\\"%@\\\"? Le voci in questa cartella non saranno eliminate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir a pasta \\\"%@\\\"? Os voicings desta pasta não serão excluídos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Map \\\"%@\\\" verwijderen? Voicings in deze map worden niet verwijderd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить папку \\\"%@\\\"? Аккорды в этой папке не будут удалены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\\"%@\\\" klasörü silinsin mi? Bu klasördeki seslendirmeler silinmeyecek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć folder \\\"%@\\\"? Prowadzenia głosów w tym folderze nie zostaną usunięte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ「%@」を削除しますか？フォルダ内のボイシングは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\\"%@\\\" 폴더를 삭제할까요? 폴더 안의 보이싱은 삭제되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डर \\\"%@\\\" हटाएँ? इस फोल्डर की वॉइसिंग हटाई नहीं जाएँगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus folder \\\"%@\\\"? Voicing di folder ini tidak akan dihapus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف المجلد \\\"%@\\\"؟ لن يتم حذف التوزيعات الصوتية في هذا المجلد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除文件夹 \\\"%@\\\"？文件夹中的指法不会被删除。"
          }
        }
      }
    },
    "favorites_empty_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse the Chords tab and tap the heart icon on a voicing to save it here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez l'onglet Accords et touchez l'icône cœur sur un voicing pour l'enregistrer ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöbere im Akkorde-Tab und tippe auf das Herz-Symbol bei einem Voicing, um es hier zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora la pestaña Acordes y toca el icono de corazón en un voicing para guardarlo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia la scheda Accordi e tocca l'icona del cuore su una voce per salvarla qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore a aba Acordes e toque no ícone de coração em um voicing para salvá-lo aqui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door het tabblad Akkoorden en tik op het hartje bij een voicing om deze hier op te slaan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите вкладку «Аккорды» и нажмите значок сердца на варианте, чтобы сохранить его здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akorlar sekmesine göz atın ve bir seslendirmedeki kalp simgesine dokunarak buraya kaydedin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj kartę Akordy i dotknij ikony serca przy prowadzeniu głosów, aby zapisać je tutaj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードタブでボイシングのハートアイコンをタップすると、ここに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 탭에서 보이싱의 하트 아이콘을 탭하면 여기에 저장됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉर्ड्स टैब में ब्राउज़ करें और किसी वॉइसिंग पर हार्ट आइकन टैप करके यहाँ सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi tab Akor dan ketuk ikon hati pada voicing untuk menyimpannya di sini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفح تبويب الأوتار وانقر على أيقونة القلب على أي توزيع صوتي لحفظه هنا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览和弦页面，点击指法上的心形图标即可收藏。"
          }
        }
      }
    },
