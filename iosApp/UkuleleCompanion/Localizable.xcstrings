    "routine_chord_drill_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل بين %1$@ و %2$@ مع مترونوم. ابدأ عند 60 BPM وزِد 10 كل دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle zwischen %1$@ und %2$@ mit Metronom. Beginne bei 60 BPM und steigere um 10 jede Minute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch between %1$@ and %2$@ with a metronome. Start at 60 BPM and increase by 10 each minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia entre %1$@ y %2$@ con metrónomo. Empieza a 60 BPM y sube 10 cada minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternez entre %1$@ et %2$@ avec un métronome. Commencez à 60 BPM et augmentez de 10 chaque minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेट्रोनोम के साथ %1$@ और %2$@ के बीच बदलें। 60 BPM से शुरू करें और हर मिनट 10 बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peralihan antara %1$@ dan %2$@ dengan metronom. Mulai 60 BPM dan naikkan 10 setiap menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna tra %1$@ e %2$@ con un metronomo. Inizia a 60 BPM e aumenta di 10 ogni minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メトロノームで%1$@と%2$@を切り替え。60 BPMから始め、1分ごとに10上げる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메트로놈으로 %1$@와 %2$@ 전환. 60 BPM에서 시작해 1분마다 10씩 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel tussen %1$@ en %2$@ met een metronoom. Begin op 60 BPM en verhoog elke minuut met 10."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełączaj między %1$@ a %2$@ z metronomem. Zacznij od 60 BPM i zwiększaj o 10 co minutę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar entre %1$@ e %2$@ com metrônomo. Comece a 60 BPM e aumente 10 a cada minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайтесь между %1$@ и %2$@ с метрономом. Начните с 60 BPM и увеличивайте на 10 каждую минуту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metronomla %1$@ ve %2$@ arasında geçiş yapın. 60 BPM'de başlayın, her dakika 10 artırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用节拍器在 %1$@ 和 %2$@ 之间切换。从 60 BPM 开始，每分钟增加 10。"
          }
        }
      }
    },
