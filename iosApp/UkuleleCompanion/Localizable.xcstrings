    "note_map_tip_2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم فلتر الإبراز للعثور على جميع مواضع نوتة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende den Hervorhebungsfilter, um alle Positionen einer Note zu finden"
