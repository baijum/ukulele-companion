        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siklus C-Am-F-G pada 80 BPM, 4 ketukan per akor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دور عبر C-Am-F-G عند 80 BPM، 4 نبضات لكل وتر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 80 BPM 循环 C-Am-F-G，每和弦 4 拍。"
          }
        }
      }
    },
    "routine_warmup_intermediate_3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice barre chord shapes slowly up the neck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratiquez les formes de barré lentement sur le manche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe Barré-Akkordformen langsam am Hals entlang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica posiciones de cejilla lentamente por el mástil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati con le forme di accordi barré lentamente lungo la tastiera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique formas de acordes de barra lentamente ao longo do braço."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen barré-akkoordgrepen langzaam langs de hals."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отработайте формы баррэ медленно вверх по грифу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare akor şekillerini klavyede yukarı doğru yavaşça çalışın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz powoli kształty akordów baryłkowych w górę gryfu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バレーコードのフォームをネック上でゆっくり練習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바레 코드 폼을 넥 위로 천천히 연습하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्दन पर धीरे बार कॉर्ड शेप का अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih bentuk akor barre perlahan ke atas leher."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرب على أشكال أوتار البار ببطء صعوداً على الرقبة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢在指板上练习横按和弦指型。"
          }
        }
      }
    },
