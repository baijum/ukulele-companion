    "songbook_field_lyrics_hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم [اسم الوتر] للأوتار، مثل Some[C]where over the [Em]rainbow"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende [Akkordname] für Akkorde, z.B. Irgend[C]wo über dem [Em]Regenbogen"
