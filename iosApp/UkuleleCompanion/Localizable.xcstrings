    "mic_permission_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tuner needs access to your microphone to listen to your ukulele and detect the pitch of each string."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accordeur a besoin d'accéder à votre microphone pour écouter votre ukulélé et détecter la hauteur de chaque corde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stimmgerät benötigt Zugriff auf dein Mikrofon, um deine Ukulele zu hören und die Tonhöhe jeder Saite zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El afinador necesita acceso al micrófono para escuchar tu ukelele y detectar el tono de cada cuerda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accordatore necessita dell'accesso al microfono per ascoltare il tuo ukulele e rilevare l'altezza di ogni corda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O afinador precisa de acesso ao microfone para ouvir seu ukulele e detectar o tom de cada corda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het stemapparaat heeft microfoontoegang nodig om naar je ukulele te luisteren en de toonhoogte van elke snaar te detecteren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тюнеру нужен доступ к микрофону, чтобы слушать укулеле и определять высоту звука каждой струны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akort cihazının ukulelenizi dinlemesi ve her telin perdesini algılaması için mikrofon erişimi gerekir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuner potrzebuje dostępu do mikrofonu, aby słuchać Twojego ukulele i wykrywać wysokość dźwięku każdej struny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューナーがウクレレの音を聴いて各弦のピッチを検出するには、マイクへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튜너가 우쿨렐레 소리를 듣고 각 현의 피치를 감지하려면 마이크 접근이 필요합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्यूनर को आपके यूकुलेले को सुनने और हर तार की पिच पहचानने के लिए माइक्रोफ़ोन एक्सेस की ज़रूरत है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuner memerlukan akses mikrofon untuk mendengarkan ukulele Anda dan mendeteksi nada setiap senar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج الموالف إلى الوصول إلى الميكروفون للاستماع إلى اليوكوليلي واكتشاف نغمة كل وتر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调音器需要访问你的麦克风来聆听尤克里里并检测每根弦的音高。"
          }
        }
      }
    },
