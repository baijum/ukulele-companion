          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El pozisyonunuzu kontrol etmek için ayna karşısında çalışın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz przed lustrem, aby sprawdzić pozycję rąk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡の前で練習して、手の位置を確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거울 앞에서 연습하며 손 자세를 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने हाथ की स्थिति जाँचने के लिए आईने के सामने अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlatihlah di depan cermin untuk memeriksa posisi tangan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرن أمام المرآة للتحقق من وضع يدك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对着镜子练习以检查手部姿势。"
          }
        }
      }
    },
    "daily_tip_6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on smooth transitions rather than speed — speed comes with time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez-vous sur des transitions fluides plutôt que sur la vitesse — la vitesse viendra avec le temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzentriere dich auf fließende Übergänge statt auf Geschwindigkeit — die kommt mit der Zeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concéntrate en transiciones suaves en lugar de velocidad — la velocidad viene con el tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrati sulle transizioni fluide piuttosto che sulla velocità — la velocità arriverà con il tempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foque em transições suaves em vez de velocidade — a velocidade vem com o tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt je op vloeiende overgangen in plaats van snelheid — snelheid komt met de tijd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стремитесь к плавным переходам, а не к скорости — скорость придёт со временем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızdan çok akıcı geçişlere odaklanın — hız zamanla gelir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skup się na płynnych przejściach, a nie na szybkości — szybkość przyjdzie z czasem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピードより滑らかな移行に集中しましょう — 速さは後からついてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도보다 부드러운 전환에 집중하세요 — 속도는 나중에 따라옵니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गति के बजाय सहज ट्रांज़िशन पर ध्यान दें — गति समय के साथ आती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus pada transisi yang mulus daripada kecepatan — kecepatan akan datang seiring waktu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ركز على الانتقالات السلسة بدلاً من السرعة — السرعة تأتي مع الوقت."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注于流畅的转换而不是速度——速度会随时间自然提升。"
          }
        }
      }
    },
    "daily_tip_7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn songs you love! Motivation makes practice enjoyable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez des chansons que vous aimez ! La motivation rend la pratique agréable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne Songs, die du liebst! Motivation macht das Üben zum Vergnügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Aprende canciones que te gusten! La motivación hace la práctica más agradable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara canzoni che ami! La motivazione rende la pratica piacevole."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda músicas que você gosta! A motivação torna a prática prazerosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer liedjes die je leuk vindt! Motivatie maakt oefenen plezierig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учите песни, которые вам нравятся! Мотивация делает практику приятной."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevdiğiniz şarkıları öğrenin! Motivasyon pratiği keyifli kılar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucz się piosenek, które lubisz! Motywacja sprawia, że ćwiczenie jest przyjemne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きな曲を覚えましょう！モチベーションが練習を楽しくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 곡을 배우세요! 동기 부여가 연습을 즐겁게 만듭니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा गाने सीखें! प्रेरणा अभ्यास को आनंदमय बनाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajari lagu yang Anda sukai! Motivasi membuat latihan menyenangkan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلم أغانٍ تحبها! الشغف يجعل التمرين ممتعاً."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习你喜欢的歌曲！热爱让练习变得愉快。"
          }
