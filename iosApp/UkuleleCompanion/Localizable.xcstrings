    "routine_scale_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعزف سلم %@ صاعداً ونازلاً. جرّب في مواضع مختلفة على لوحة الأصابع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele die %@-Tonleiter auf- und absteigend. Probiere verschiedene Positionen am Griffbrett."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play the %@ scale ascending and descending. Try in different positions on the fretboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la escala %@ ascendente y descendente. Prueba en diferentes posiciones del mástil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouez la gamme %@ en montant et descendant. Essayez dans différentes positions du manche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ स्केल आरोही और अवरोही बजाएँ। फ्रेटबोर्ड पर अलग-अलग स्थितियों में आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainkan tangga nada %@ naik dan turun. Coba di posisi berbeda pada fretboard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona la scala %@ ascendente e discendente. Prova in diverse posizioni sulla tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@スケールを上行・下行で弾く。フレットボードの異なるポジションで試す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 스케일을 상행·하행으로 연주하세요. 지판의 다른 포지션에서 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel de %@ toonladder oplopend en aflopend. Probeer verschillende posities op het toetsenbord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graj gamę %@ w górę i w dół. Spróbuj w różnych pozycjach na gryfie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar a escala %@ ascendente e descendente. Experimente em diferentes posições no braço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сыграйте гамму %@ вверх и вниз. Попробуйте разные позиции на грифе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dizisini yukarı ve aşağı çalın. Klavyede farklı pozisyonlarda deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上行和下行弹奏 %@ 音阶。试试指板上的不同把位。"
          }
        }
      }
    },
