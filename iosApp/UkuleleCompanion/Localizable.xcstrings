    "settings_tagline" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفيقك الشامل لليوكوليلي للأوتار والسلالم والنظرية الموسيقية والتأليف. مجاني، بدون إنترنت، بدون إعلانات، بدون تتبع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Rundum-Begleiter für Ukulele — Akkorde, Tonleitern, Musiktheorie und Komposition. Kostenlos, offline, keine Werbung, kein Tracking."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your all-in-one ukulele companion for chords, scales, music theory, and composition. Free, offline, no ads, no tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compañero todo en uno para ukelele: acordes, escalas, teoría musical y composición. Gratis, sin conexión, sin anuncios, sin rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compagnon tout-en-un pour le ukulélé : accords, gammes, théorie musicale et composition. Gratuit, hors ligne, sans pub, sans pistage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉर्ड्स, स्केल, संगीत सिद्धांत और रचना के लिए आपका ऑल-इन-वन यूकुलेले साथी। मुफ़्त, ऑफ़लाइन, बिना विज्ञापन, बिना ट्रैकिंग।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teman ukulele lengkap untuk akor, tangga nada, teori musik, dan komposisi. Gratis, offline, tanpa iklan, tanpa pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo compagno completo per ukulele: accordi, scale, teoria musicale e composizione. Gratuito, offline, senza pubblicità, senza tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード、スケール、音楽理論、作曲のためのオールインワン・ウクレレコンパニオン。無料、オフライン、広告なし、トラッキングなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드, 스케일, 음악 이론, 작곡을 위한 올인원 우쿨렐레 컴패니언. 무료, 오프라인, 광고 없음, 추적 없음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je alles-in-één ukulele-metgezel voor akkoorden, toonladders, muziektheorie en compositie. Gratis, offline, geen advertenties, geen tracking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój kompletny towarzysz ukulele — akordy, skale, teoria muzyki i kompozycja. Darmowy, offline, bez reklam, bez śledzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu companheiro completo para ukulele: acordes, escalas, teoria musical e composição. Grátis, offline, sem anúncios, sem rastreamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш универсальный помощник для укулеле: аккорды, гаммы, теория музыки и сочинение. Бесплатно, офлайн, без рекламы и отслеживания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akorlar, diziler, müzik teorisi ve kompozisyon için hepsi bir arada ukulele yardımcınız. Ücretsiz, çevrimdışı, reklamsız, izleme yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的全能尤克里里伴侣，涵盖和弦、音阶、乐理和创作。免费、离线、无广告、无追踪。"
          }
        }
      }
    },
