    "play_along_choose" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مفتاحاً وتقدماً لحنياً، ثم اعزف مع اكتشاف الأوتار في الوقت الحقيقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Tonart und Akkordfolge, dann spiele mit Echtzeit-Akkorderkennung mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a key and progression, then play along with real-time chord detection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una tonalidad y progresión, luego toca junto con la detección de acordes en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une tonalité et une progression, puis jouez avec la détection d'accords en temps réel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक कुंजी और प्रोग्रेशन चुनें, फिर रियल-टाइम कॉर्ड पहचान के साथ बजाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kunci dan progresi, lalu bermain bersama dengan deteksi akor waktu nyata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una tonalità e una progressione, poi suona insieme con il rilevamento accordi in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーとコード進行を選んで、リアルタイムコード検出で一緒に弾きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키와 코드 진행을 선택하고 실시간 코드 감지로 함께 연주하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een toonsoort en progressie, en speel dan mee met real-time akkoorddetectie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz tonację i progresję, a następnie graj razem z wykrywaniem akordów w czasie rzeczywistym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma tonalidade e progressão, depois toque junto com a detecção de acordes em tempo real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите тональность и прогрессию, затем играйте с определением аккордов в реальном времени."
          }
        },
        "tr" : {
