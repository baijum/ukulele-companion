    "routine_cool_down_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعزف ما تستمتع به! تدرب على أغنية مفضلة أو اعزف بحرية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele etwas, das dir gefällt! Übe ein Lieblingslied oder schlage frei an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play something you enjoy! Practice a favourite song or strum freely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Toca algo que disfrutes! Practica una canción favorita o rasguea libremente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouez quelque chose que vous aimez ! Pratiquez une chanson favorite ou grattez librement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो आपको पसंद है वह बजाएँ! पसंदीदा गाना अभ्यास करें या स्वतंत्र रूप से स्ट्रम करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainkan sesuatu yang Anda nikmati! Latih lagu favorit atau strum bebas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona qualcosa che ti piace! Pratica un brano preferito o strimpella liberamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きな曲を弾こう！お気に入りの曲を練習するか自由にストローク。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아하는 곡을 연주하세요! 좋아하는 곡을 연습하거나 자유롭게 스트러밍하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel iets wat je leuk vindt! Oefen een favoriet liedje of tokkel vrij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zagraj coś, co lubisz! Ćwicz ulubioną piosenkę lub brzdąkaj swobodnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque algo que goste! Pratique uma música favorita ou toque livremente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сыграйте то, что вам нравится! Отработайте любимую песню или импровизируйте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyif aldığınız bir şey çalın! Favori şarkınızı çalışın veya serbest strum yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弹你喜欢的！练习喜欢的歌或自由扫弦。"
          }
        }
      }
    },
