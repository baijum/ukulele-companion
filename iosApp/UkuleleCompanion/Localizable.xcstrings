            "state": "translated",
            "value": "Spiele Akkordumkehrungen am Hals entlang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca inversiones de acordes por el mástil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona rivolti di accordi lungo la tastiera per qualsiasi accordo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque inversões de acordes ao longo do braço para qualquer acorde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel akkoordomkeringen langs de hals voor elk akkoord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыграйте обращения аккордов вверх по грифу для любого аккорда."
