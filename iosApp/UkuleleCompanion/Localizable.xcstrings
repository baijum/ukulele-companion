    "settings_spoken_feedback_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announces note name and cents deviation using text-to-speech"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce le nom de la note et la déviation en cents par synthèse vocale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt Notenname und Cent-Abweichung per Sprachsynthese aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncia el nombre de la nota y la desviación en cents con síntesis de voz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuncia il nome della nota e la deviazione in centesimi tramite sintesi vocale"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncia o nome da nota e o desvio em cents usando síntese de voz"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondigt nootnaam en centafwijking aan via tekst-naar-spraak"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Озвучивает название ноты и отклонение в центах с помощью синтеза речи"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota adını ve sent sapmasını metin okuma ile duyurur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogłasza nazwę nuty i odchylenie w centach za pomocą syntezatora mowy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト読み上げで音名とセント偏差を読み上げます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 음성 변환으로 음 이름과 센트 편차를 읽어줍니다"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट-टू-स्पीच का उपयोग करके नोट का नाम और सेंट विचलन बताता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengumumkan nama not dan deviasi sen menggunakan text-to-speech"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطق اسم النوتة وانحراف السنت باستخدام تحويل النص إلى كلام"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用语音合成播报音符名称和音分偏差"
          }
        }
      }
    },
