            "state": "translated",
            "value": "在 3 个不同把位用大调音阶热身。"
          }
        }
      }
    },
    "routine_warmup_advanced_2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play chord inversions up the neck for any chord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez les renversements d'accords sur le manche."
          }
        },
        "de": {
