    "challenge_transition_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice switching between %1$@ and %2$@ at 60 BPM. Aim for 20 switches per minute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratiquez le changement entre %1$@ et %2$@ à 60 BPM. Visez 20 changements par minute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe den Wechsel zwischen %1$@ und %2$@ bei 60 BPM. Ziel: 20 Wechsel pro Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica el cambio entre %1$@ y %2$@ a 60 BPM. Intenta 20 cambios por minuto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratica il passaggio tra %1$@ e %2$@ a 60 BPM. Obiettivo: 20 cambi al minuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Praticar a alternância entre %1$@ e %2$@ a 60 BPM. Objetivo: 20 mudanças por minuto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen het wisselen tussen %1$@ en %2$@ op 60 BPM. Streef naar 20 wisselingen per minuut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отработайте переключение между %1$@ и %2$@ при 60 BPM. Цель — 20 переключений в минуту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "60 BPM'de %1$@ ve %2$@ arasında geçiş pratiği yapın. Dakikada 20 geçiş hedefleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz przełączanie między %1$@ a %2$@ przy 60 BPM. Cel: 20 przełączeń na minutę."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@の切り替えを60 BPMで練習。1分間に20回切り替えを目指す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60 BPM으로 %1$@와 %2$@ 전환 연습. 분당 20회 전환을 목표로 하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "60 BPM पर %1$@ और %2$@ के बीच बदलने का अभ्यास करें। प्रति मिनट 20 स्विच का लक्ष्य रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih peralihan antara %1$@ dan %2$@ pada 60 BPM. Target 20 peralihan per menit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرب على التبديل بين %1$@ و %2$@ عند 60 BPM. استهدف 20 تبديلاً في الدقيقة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 60 BPM 练习在 %1$@ 和 %2$@ 之间切换。目标每分钟 20 次切换。"
          }
        }
      }
    },
