    "theory_lessons_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Structured lessons from fundamentals to advanced harmony."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des leçons structurées des fondamentaux à l'harmonie avancée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strukturierte Lektionen von den Grundlagen bis zur fortgeschrittenen Harmonik."
