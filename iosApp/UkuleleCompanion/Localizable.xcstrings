    "note_map_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلم كل نوتة على لوحة أصابع اليوكوليلي."
