    "settings_tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your all-in-one ukulele companion for chords, scales, music theory, and composition. Fully offline, no tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compagnon tout-en-un pour le ukulélé : accords, gammes, théorie musicale et composition. Entièrement hors ligne, sans pistage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Rundum-Begleiter für Ukulele — Akkorde, Tonleitern, Musiktheorie und Komposition. Vollständig offline, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compañero todo en uno para ukelele: acordes, escalas, teoría musical y composición. Totalmente sin conexión, sin rastreo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo compagno completo per ukulele: accordi, scale, teoria musicale e composizione. Completamente offline, senza tracciamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu companheiro completo para ukulele: acordes, escalas, teoria musical e composição. Totalmente offline, sem rastreamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je alles-in-één ukulele-metgezel voor akkoorden, toonladders, muziektheorie en compositie. Volledig offline, geen tracking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш универсальный помощник для укулеле: аккорды, гаммы, теория музыки и сочинение. Полностью офлайн, без отслеживания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akorlar, diziler, müzik teorisi ve kompozisyon için hepsi bir arada ukulele yardımcınız. Tamamen çevrimdışı, izleme yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój kompletny towarzysz ukulele — akordy, skale, teoria muzyki i kompozycja. W pełni offline, bez śledzenia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード、スケール、音楽理論、作曲のためのオールインワン・ウクレレコンパニオン。完全オフライン、トラッキングなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드, 스케일, 음악 이론, 작곡을 위한 올인원 우쿨렐레 컴패니언. 완전히 오프라인, 추적 없음."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉर्ड्स, स्केल, संगीत सिद्धांत और रचना के लिए आपका ऑल-इन-वन यूकुलेले साथी। पूरी तरह ऑफ़लाइन, बिना ट्रैकिंग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman ukulele lengkap untuk akor, tangga nada, teori musik, dan komposisi. Sepenuhnya offline, tanpa pelacakan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفيقك الشامل لليوكوليلي للأوتار والسلالم والنظرية الموسيقية والتأليف. يعمل بدون إنترنت، بدون تتبع."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的全能尤克里里伴侣，涵盖和弦、音阶、乐理和创作。完全离线、无追踪。"
          }
        }
      }
    },
