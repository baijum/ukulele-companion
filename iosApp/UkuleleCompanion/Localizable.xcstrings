    "note_map_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn every note on the ukulele fretboard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez chaque note sur le manche du ukulélé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne jede Note auf dem Ukulele-Griffbrett."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende cada nota en el diapasón del ukelele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara ogni nota sulla tastiera dell'ukulele."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda cada nota no braço do ukulele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer elke noot op het ukulele-toetsenbord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучите каждую ноту на грифе укулеле."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukulele klavyesindeki her notayı öğrenin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naucz się każdej nuty na gryfie ukulele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウクレレのフレットボード上のすべての音を覚えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우쿨렐레 지판의 모든 음을 익히세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यूकुलेले फ्रेटबोर्ड पर हर नोट सीखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajari setiap not pada fretboard ukulele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلم كل نوتة على لوحة أصابع اليوكوليلي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习尤克里里指板上的每个音符。"
          }
        }
      }
    },
    "note_map_tip_1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any note to hear it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez n'importe quelle note pour l'écouter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Note, um sie zu hören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier nota para escucharla"
          }
