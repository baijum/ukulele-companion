    "challenge_scale_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice the %@ scale in at least 2 different keys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratiquez la gamme %@ dans au moins 2 tonalités différentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe die %@-Tonleiter in mindestens 2 verschiedenen Tonarten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica la escala %@ en al menos 2 tonalidades diferentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratica la scala %@ in almeno 2 tonalità diverse."
          }
