    "challenge_practice_song_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the songbook and practice any song for 5 minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le recueil et pratiquez n'importe quelle chanson pendant 5 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Liederbuch und übe ein beliebiges Lied 5 Minuten lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el cancionero y practica cualquier canción durante 5 minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la raccolta e pratica un brano qualsiasi per 5 minuti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o caderno e praticar qualquer música durante 5 minutos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het liedjesboek en oefen 5 minuten met een liedje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте песенник и отработайте любую песню 5 минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkı defterini açın ve herhangi bir şarkıyı 5 dakika çalışın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz śpiewnik i ćwicz dowolną piosenkę przez 5 minut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソングブックを開いて5分間好きな曲を練習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡 목록을 열고 5분간 아무 곡이나 연습하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सॉन्गबुक खोलें और 5 मिनट के लिए कोई गाना अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka buku lagu dan latih lagu apa pun selama 5 menit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح دفتر الأغاني وتدرب على أي أغنية لمدة 5 دقائق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开歌本，练习任意歌曲 5 分钟。"
          }
        }
      }
    },
