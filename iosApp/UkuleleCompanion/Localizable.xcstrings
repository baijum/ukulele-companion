          "stringUnit": {
            "state": "translated",
            "value": "Gestructureerde lessen van basisbegrippen tot geavanceerde harmonie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Структурированные уроки от основ до продвинутой гармонии."
