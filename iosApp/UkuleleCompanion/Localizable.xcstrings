    "daily_tip_1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even 5 minutes of daily practice is better than 1 hour once a week."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même 5 minutes de pratique quotidienne valent mieux qu'1 heure une fois par semaine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst 5 Minuten tägliches Üben sind besser als 1 Stunde pro Woche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso 5 minutos de práctica diaria son mejores que 1 hora una vez a la semana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche solo 5 minuti di pratica quotidiana sono meglio di 1 ora una volta a settimana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo 5 minutos de prática diária são melhores do que 1 hora uma vez por semana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs 5 minuten dagelijks oefenen is beter dan 1 uur per week."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже 5 минут ежедневной практики лучше, чем 1 час раз в неделю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük 5 dakika pratik bile haftada 1 saatten daha iyidir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet 5 minut codziennych ćwiczeń jest lepsze niż 1 godzina raz w tygodniu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日5分の練習でも、週に1度の1時間より効果的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 5분이라도 연습하는 것이 일주일에 한 번 1시간보다 효과적입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ 5 मिनट का अभ्यास भी हफ़्ते में एक बार 1 घंटे से बेहतर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahkan 5 menit latihan harian lebih baik daripada 1 jam sekali seminggu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى 5 دقائق من التمرين اليومي أفضل من ساعة واحدة أسبوعياً."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天练习5分钟也比每周一次练1小时要好。"
          }
        }
      }
    },
    "daily_tip_2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a metronome when practising chord changes — start slow and build up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un métronome pour les changements d'accords — commencez lentement et accélérez progressivement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende ein Metronom beim Üben von Akkordwechseln — fange langsam an und steigere dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un metrónomo al practicar cambios de acordes — empieza lento y ve aumentando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un metronomo quando ti eserciti nei cambi di accordo — inizia piano e aumenta gradualmente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um metrônomo ao praticar mudanças de acordes — comece devagar e vá acelerando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een metronoom bij het oefenen van akkoordwisselingen — begin langzaam en bouw op."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте метроном при отработке смены аккордов — начинайте медленно и ускоряйтесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akor geçişleri çalışırken metronom kullanın — yavaş başlayın ve hızlanın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj metronomu podczas ćwiczenia zmian akordów — zacznij powoli i stopniowo przyspieszaj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードチェンジの練習にはメトロノームを使いましょう — ゆっくり始めて徐々に速く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 전환을 연습할 때는 메트로놈을 사용하세요 — 느리게 시작해서 점점 빠르게."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉर्ड बदलने का अभ्यास करते समय मेट्रोनोम का उपयोग करें — धीमे शुरू करें और गति बढ़ाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan metronom saat berlatih pergantian akor — mulai pelan dan tingkatkan bertahap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم المترونوم عند التمرن على تغيير الأوتار — ابدأ ببطء ثم زد السرعة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习和弦转换时使用节拍器——从慢速开始逐步加快。"
          }
        }
      }
    },
    "daily_tip_3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When learning a new chord, play each string individually to check clarity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En apprenant un nouvel accord, jouez chaque corde individuellement pour vérifier la clarté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen neuen Akkord lernst, spiele jede Saite einzeln, um die Klarheit zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aprender un acorde nuevo, toca cada cuerda individualmente para verificar la claridad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando impari un nuovo accordo, suona ogni corda singolarmente per verificare la chiarezza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao aprender um novo acorde, toque cada corda individualmente para verificar a clareza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het leren van een nieuw akkoord, speel elke snaar apart om de helderheid te controleren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучая новый аккорд, играйте каждую струну отдельно, чтобы проверить чистоту звука."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir akor öğrenirken netliği kontrol etmek için her teli ayrı ayrı çalın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucząc się nowego akordu, zagraj każdą strunę osobno, aby sprawdzić czystość dźwięku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコードを覚えるときは、各弦を1本ずつ鳴らして音がクリアか確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 코드를 배울 때는 각 현을 하나씩 소리 내어 깨끗한지 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया कॉर्ड सीखते समय, स्पष्टता जाँचने के लिए हर तार को अलग-अलग बजाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat mempelajari akor baru, petik setiap senar satu per satu untuk memeriksa kejelasannya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تعلم وتر جديد، اعزف كل وتر على حدة للتأكد من وضوح الصوت."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习新和弦时，逐根弦弹奏以检查声音是否清晰。"
          }
        }
      }
    },
    "daily_tip_4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try humming along while strumming to develop your musical ear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de fredonner en grattant pour développer votre oreille musicale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, beim Spielen mitzusummen, um dein musikalisches Gehör zu schulen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta tararear mientras rasgueas para desarrollar tu oído musical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a canticchiare mentre strimpelli per sviluppare il tuo orecchio musicale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente cantarolar enquanto toca para desenvolver seu ouvido musical."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer mee te neuriën terwijl je tokkelt om je muzikaal gehoor te ontwikkelen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте напевать во время игры боем — это развивает музыкальный слух."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strum yaparken mırıldanmayı deneyin, müzik kulağınızı geliştirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj nucić podczas grania, aby rozwijać swój słuch muzyczny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストロークしながら一緒にハミングして、音楽的な耳を鍛えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트러밍하면서 함께 허밍해 보세요. 음악적 귀가 발달합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रम करते समय साथ में गुनगुनाने की कोशिश करें — यह आपके संगीत कान को विकसित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba bersenandung sambil memainkan strumming untuk mengembangkan pendengaran musik Anda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول الطنين مع العزف لتطوير أذنك الموسيقية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试在扫弦时跟着哼唱，培养你的音乐听觉。"
          }
        }
      }
    },
    "daily_tip_5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice in front of a mirror to check your hand position."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînez-vous devant un miroir pour vérifier la position de votre main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe vor einem Spiegel, um deine Handhaltung zu kontrollieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica frente a un espejo para revisar la posición de tu mano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati davanti a uno specchio per controllare la posizione delle mani."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
