    "daily_tip_2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم المترونوم عند التمرن على تغيير الأوتار — ابدأ ببطء ثم زد السرعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende ein Metronom beim Üben von Akkordwechseln — fange langsam an und steigere dich."
          }
        },
        "en" : {
          "stringUnit" : {
