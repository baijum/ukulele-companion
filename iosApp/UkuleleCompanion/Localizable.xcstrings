    "songbook_empty_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to create your first chord sheet.\\nOr import a ChordPro file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour créer votre première grille d'accords.\\nOu importez un fichier ChordPro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf +, um dein erstes Akkordblatt zu erstellen.\\nOder importiere eine ChordPro-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para crear tu primera hoja de acordes.\\nO importa un archivo ChordPro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + per creare la tua prima scheda accordi.\\nOppure importa un file ChordPro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em + para criar sua primeira folha de acordes.\\nOu importe um arquivo ChordPro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op + om je eerste akkoordblad aan te maken.\\nOf importeer een ChordPro-bestand."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы создать первую аккордную таблицу.\\nИли импортируйте файл ChordPro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk akor sayfanızı oluşturmak için + simgesine dokunun.\\nVeya bir ChordPro dosyası içe aktarın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij +, aby utworzyć pierwszą kartę akordów.\\nLub zaimportuj plik ChordPro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+をタップして最初のコードシートを作成しましょう。\\nまたはChordProファイルをインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+를 탭하여 첫 코드 시트를 만들어 보세요.\\n또는 ChordPro 파일을 가져올 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पहली कॉर्ड शीट बनाने के लिए + टैप करें।\\nया ChordPro फ़ाइल आयात करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk + untuk membuat lembar akor pertama Anda.\\nAtau impor file ChordPro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر + لإنشاء أول ورقة أوتار.\\nأو استورد ملف ChordPro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 + 创建你的第一个和弦谱。\\n或导入 ChordPro 文件。"
          }
        }
      }
    },
