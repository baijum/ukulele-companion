            "value": "以舒适速度指弹琶音模式。"
          }
        }
      }
    },
    "routine_warmup_beginner_1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly strum each open string (G-C-E-A) and listen for clear tones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grattez lentement chaque corde à vide (G-C-E-A) et écoutez les sons clairs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlage langsam jede offene Saite an (G-C-E-A) und höre auf klare Töne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasguea lentamente cada cuerda al aire (G-C-E-A) y escucha tonos claros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumma lentamente ogni corda aperta (G-C-E-A) e ascolta toni chiari."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque lentamente cada corda aberta (G-C-E-A) e ouça tons claros."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokkel langzaam elke open snaar (G-C-E-A) en luister naar heldere tonen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно бейте по каждой открытой струне (G-C-E-A) и слушайте чистые тоны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her açık teli (G-C-E-A) yavaşça strum yapın ve net tonları dinleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powoli brzdąkaj każdą otwartą strunę (G-C-E-A) i słuchaj czystych dźwięków."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各開放弦（G-C-E-A）をゆっくりストロークしてクリアな音を聴く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 개방현(G-C-E-A)을 천천히 스트러밍하며 깨끗한 소리를 들으세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे हर ओपन स्ट्रिंग (G-C-E-A) स्ट्रम करें और स्पष्ट स्वर सुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Strum perlahan setiap senar terbuka (G-C-E-A) dan dengarkan nada yang jelas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف كل وتر مفتوح ببطء (G-C-E-A) واستمع للنغمات الواضحة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢扫每根空弦（G-C-E-A），听清音色。"
          }
        }
      }
    },
    "routine_warmup_beginner_2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice placing and lifting your fingers on the C chord shape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratiquez le placement des doigts sur la forme de l'accord C."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe das Aufsetzen und Abheben der Finger auf der C-Akkordform."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica colocar y levantar los dedos en la posición del acorde C."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati a posizionare e sollevare le dita sulla forma dell'accordo C."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique colocar e levantar os dedos na forma do acorde C."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen het plaatsen en optillen van je vingers op de C-akkoordgreep."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отработайте постановку и снятие пальцев с формы аккорда C."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "C akor şeklinde parmak yerleştirme ve kaldırma pratiği yapın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz kładzenie i podnoszenie palców w kształcie akordu C."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cコードのフォームで指を置いたり離したりする練習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "C코드 폼으로 손가락을 놓고 떼는 연습을 하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "C कॉर्ड शेप पर उँगलियाँ रखने और उठाने का अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih menempatkan dan mengangkat jari pada bentuk akor C."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرب على وضع وإزالة أصابعك على شكل وتر C."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习在 C 和弦指型上按弦和抬指。"
          }
        }
      }
    },
    "routine_warmup_beginner_3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strum C and Am chords slowly, 4 beats each, for 2 minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grattez les accords C et Am lentement, 4 temps chacun, pendant 2 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlage die Akkorde C und Am langsam an, je 4 Schläge, 2 Minuten lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasguea los acordes C y Am lentamente, 4 tiempos cada uno, durante 2 minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumma gli accordi C e Am lentamente, 4 battiti ciascuno, per 2 minuti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque os acordes C e Am lentamente, 4 batidas cada, durante 2 minutos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokkel C- en Am-akkoorden langzaam, 4 tellen elk, gedurende 2 minuten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте аккорды C и Am медленно, по 4 доли каждый, 2 минуты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "C ve Am akorlarını yavaşça strum yapın, her biri 4 vuruş, 2 dakika."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brzdąkaj akordy C i Am powoli, po 4 uderzenia każdy, przez 2 minuty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CとAmコードをゆっくり、各4拍、2分間ストローク。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "C와 Am 코드를 천천히, 각 4박, 2분간 스트러밍하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2 मिनट के लिए धीरे C और Am कॉर्ड स्ट्रम करें, प्रत्येक में 4 बीट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Strum akor C dan Am perlahan, 4 ketukan masing-masing, selama 2 menit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف أوتار C و Am ببطء، 4 نبضات لكل منهما، لمدة دقيقتين."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢速扫 C 和 Am 和弦，各 4 拍，持续 2 分钟。"
          }
        }
      }
    },
    "routine_warmup_intermediate_1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a chromatic scale on each string from fret 1 to 5 and back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez une gamme chromatique sur chaque corde de la case 1 à 5 et retour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele eine chromatische Tonleiter auf jeder Saite von Bund 1 bis 5 und zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una escala cromática en cada cuerda del traste 1 al 5 y vuelta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona una scala cromatica su ogni corda dal tasto 1 al 5 e ritorno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque uma escala cromática em cada corda do traste 1 ao 5 e volte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel een chromatische toonladder op elke snaar van fret 1 tot 5 en terug."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыграйте хроматическую гамму на каждой струне с 1-го по 5-й лад и обратно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her telde 1. perdeden 5. perdeye ve geri kromatik dizi çalın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj gamę chromatyczną na każdej strunie od progu 1 do 5 i z powrotem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各弦でフレット1から5まで半音階スケールを往復で弾く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 현에서 프렛 1부터 5까지 반음계를 오가며 연주하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्रेट 1 से 5 तक और वापस हर स्ट्रिंग पर क्रोमैटिक स्केल बजाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan tangga nada kromatik pada setiap senar dari fret 1 ke 5 dan kembali."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف سلم كروماتي على كل وتر من الحنق 1 إلى 5 والعودة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每根弦上从 1 品到 5 品来回弹半音阶。"
          }
        }
      }
    },
    "routine_warmup_intermediate_2": {
      "localizations": {
        "en": {
