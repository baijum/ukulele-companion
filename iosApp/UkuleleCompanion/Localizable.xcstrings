    "melody_discard_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved changes. Discard them?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez des modifications non enregistrées. Les abandonner ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ungespeicherte Änderungen. Verwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes cambios sin guardar. ¿Descartarlos?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai modifiche non salvate. Scartarle?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem alterações não salvas. Descartar?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt niet-opgeslagen wijzigingen. Verwerpen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас есть несохранённые изменения. Отменить?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmemiş değişiklikleriniz var. Vazgeçilsin mi?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz niezapisane zmiany. Odrzucić?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存の変更があります。破棄しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 변경 사항이 있습니다. 삭제하시겠습니까?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास बिना सहेजे बदलाव हैं। छोड़ दें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memiliki perubahan yang belum disimpan. Buang?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك تغييرات غير محفوظة. هل تريد تجاهلها؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您有未保存的更改。要放弃吗？"
          }
        }
      }
    },
