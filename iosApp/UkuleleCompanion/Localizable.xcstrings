    "chord_library_inversion_tip" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفس الوتر، نوتة باص مختلفة. استمع إلى كيف أن لكل انعكاس طابعه المميز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicher Akkord, anderer Basston. Höre, wie jede Umkehrung einen eigenen Charakter hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same chord, different bass note. Listen to how each inversion has a distinct character."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo acorde, diferente nota en el bajo. Escucha cómo cada inversión tiene un carácter distinto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le même accord, une note de basse différente. Écoutez comment chaque renversement a un caractère distinct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ही कॉर्ड, अलग बेस नोट। सुनें कि हर इन्वर्शन का अपना अलग चरित्र कैसे है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akor yang sama, not bas berbeda. Dengarkan bagaimana setiap inversi memiliki karakter yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stesso accordo, nota di basso diversa. Ascolta come ogni rivolto ha un carattere distinto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じコードでもベース音が異なります。それぞれの転回形が持つ独自の響きを聴いてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 코드지만 베이스 음이 다릅니다. 각 전위가 가진 고유한 성격을 들어보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetzelfde akkoord, andere basnoot. Luister hoe elke omkering een eigen karakter heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten sam akord, inna nuta basowa. Posłuchaj, jak każdy przewrót ma własny charakter."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mesmo acorde, nota de baixo diferente. Ouça como cada inversão tem um caráter distinto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот же аккорд, другой басовый звук. Послушайте, как каждое обращение имеет свой характер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı akor, farklı bas nota. Her çevrimin farklı bir karaktere sahip olduğunu dinleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一和弦，不同低音。听听每个转位各自的特色。"
          }
        }
      }
    },
