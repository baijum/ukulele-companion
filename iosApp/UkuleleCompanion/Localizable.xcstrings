    "routine_warmup_advanced_2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعزف انعكاسات الأوتار صعوداً على الرقبة لأي وتر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele Akkordumkehrungen am Hals entlang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play chord inversions up the neck for any chord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca inversiones de acordes por el mástil."
          }
