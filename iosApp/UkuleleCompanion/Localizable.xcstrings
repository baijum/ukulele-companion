    "songbook_field_lyrics_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use [ChordName] for chords, e.g. Some[C]where over the [Em]rainbow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez [NomAccord] pour les accords, p. ex. Quel[C]que part au-dessus de l'arc-[Em]en-ciel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende [Akkordname] für Akkorde, z.B. Irgend[C]wo über dem [Em]Regenbogen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa [NombreAcorde] para acordes, p. ej. En[C] algún lugar sobre el [Em]arcoíris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa [NomeAccordo] per gli accordi, es. Da[C]qualche parte sopra l'arco[Em]baleno"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use [NomeAcorde] para acordes, ex.: Em[C] algum lugar sobre o [Em]arco-íris"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik [Akkoordnaam] voor akkoorden, bijv. Er[C]gens over de regen[Em]boog"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте [НазваниеАккорда] для аккордов, например Some[C]where over the [Em]rainbow"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akorlar için [AkorAdı] kullanın, ör. Gökkuşağı[C]nın üstünde bir[Em]yerde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj [NazwaAkordu] dla akordów, np. Gdzieś[C] ponad tęczą [Em]tam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[コード名]でコードを挿入します。例: 虹の[C]向こうの[Em]どこかに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[코드이름]으로 코드를 삽입합니다. 예: 무지개[C] 너머 어딘[Em]가에"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉर्ड के लिए [कॉर्डनाम] का उपयोग करें, जैसे Some[C]where over the [Em]rainbow"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan [NamaAkor] untuk akor, contoh: Di[C]suatu tempat di atas pela[Em]ngi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم [اسم الوتر] للأوتار، مثل Some[C]where over the [Em]rainbow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 [和弦名] 标记和弦，例如 Some[C]where over the [Em]rainbow"
          }
        }
      }
    },
