    "routine_free_play_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play whatever you like!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez ce que vous voulez !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele, was du möchtest!"
          }
        },
        "es": {
          "stringUnit": {
