        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een noot om deze te horen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на любую ноту, чтобы услышать её"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlemek için herhangi bir notaya dokunun"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij dowolnej nuty, aby ją usłyszeć"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音をタップすると聴けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음을 탭하면 들을 수 있습니다"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनने के लिए किसी भी नोट को टैप करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk not apa pun untuk mendengarnya"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر أي نوتة لسماعها"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击任何音符可试听"
          }
        }
      }
