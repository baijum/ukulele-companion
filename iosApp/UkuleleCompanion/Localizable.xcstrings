    "routine_song_practice_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر أغنية من دفتر الأغاني واعزفها. ركّز على انتقالات الأوتار السلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Lied aus deinem Liederbuch und spiele es durch. Achte auf flüssige Akkordwechsel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a song from your songbook and play through it. Focus on smooth chord changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una canción del cancionero y tócala. Concéntrate en cambios de acorde suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une chanson dans votre recueil et jouez-la. Concentrez-vous sur des changements d'accords fluides."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने सॉन्गबुक से कोई गाना चुनें और उसे बजाएँ। सहज कॉर्ड बदलाव पर ध्यान दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih lagu dari buku lagu dan mainkan. Fokus pada peralihan akor yang halus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un brano dalla tua raccolta e suonalo. Concentrati su cambi di accordi fluidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソングブックから曲を選んで通して弾く。スムーズなコードチェンジに集中。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곡 목록에서 곡을 골라 처음부터 끝까지 연주하세요. 부드러운 코드 전환에 집중하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een liedje uit je liedjesboek en speel het door. Richt je op vloeiende akkoordwisselingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz piosenkę z śpiewnika i zagraj ją. Skup się na płynnych zmianach akordów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma música do seu caderno e toque-a. Foque em mudanças de acordes suaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите песню из песенника и проиграйте её. Фокус на плавной смене аккордов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkı defterinizden bir şarkı seçin ve çalın. Akıcı akor geçişlerine odaklanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从歌本选一首歌弹一遍。专注于流畅的和弦转换。"
          }
        }
      }
    },
