          "stringUnit": {
            "state": "translated",
            "value": "Markeert automatisch de volgende ongestemde snaar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически выделяет следующую ненастроенную струну"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akort edilmemiş sonraki teli otomatik olarak vurgular"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie podświetla następną nienastrojoną strunę"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のチューニングされていない弦を自動的にハイライトします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 튜닝되지 않은 현을 자동으로 강조합니다"
