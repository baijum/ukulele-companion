    "progress_reset_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will clear all learning progress, quiz scores, streaks, and lesson completion. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci effacera toute la progression d'apprentissage, les scores de quiz, les séries et les leçons terminées. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht den gesamten Lernfortschritt, alle Quizergebnisse, Serien und abgeschlossenen Lektionen. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará todo el progreso de aprendizaje, puntuaciones de quizzes, rachas y lecciones completadas. Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno cancellati tutti i progressi di apprendimento, i punteggi dei quiz, le serie e le lezioni completate. Questa azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apagará todo o progresso de aprendizado, pontuações de quizzes, sequências e lições concluídas. Esta ação não pode ser desfeita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wist alle leervoortgang, quizscores, reeksen en voltooide lessen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит весь прогресс обучения, результаты тестов, серии и пройденные уроки. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm öğrenme ilerlemesi, test puanları, seriler ve ders tamamlamaları silinecek. Bu işlem geri alınamaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie postępy nauki, wyniki quizów, serie i ukończone lekcje zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての学習進捗、クイズのスコア、連続記録、レッスンの完了状況がクリアされます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 학습 진행 상황, 퀴즈 점수, 연속 기록, 레슨 완료 현황이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी सीखने की प्रगति, क्विज़ स्कोर, लगातार रिकॉर्ड और पाठ पूर्णता को मिटा देगा। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus semua kemajuan belajar, skor kuis, beruntun, dan pelajaran yang diselesaikan. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح جميع تقدم التعلم ونتائج الاختبارات والسلاسل المتتالية وإتمام الدروس. لا يمكن التراجع عن هذا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除所有学习进度、测验分数、连胜记录和课程完成情况。此操作无法撤销。"
          }
        }
      }
    },
    "progress_reset_title": {
      "localizations": {
