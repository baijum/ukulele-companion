        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강조 필터로 특정 음의 모든 위치를 찾을 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het markeringsfilter om alle posities van een noot te vinden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj filtra podświetlania, aby znaleźć wszystkie pozycje nuty"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
