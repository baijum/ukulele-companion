            "state": "translated",
            "value": "Praticar a escala %@ em pelo menos 2 tonalidades diferentes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen de %@ toonladder in minimaal 2 verschillende toonsoorten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отработайте гамму %@ минимум в 2 разных тональностях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dizisini en az 2 farklı tonda çalışın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz gamę %@ w co najmniej 2 różnych tonacjach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@スケールを少なくとも2つのキーで練習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 스케일을 최소 2개 키로 연습하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 2 अलग-अलग कुंजियों में %@ स्केल अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih tangga nada %@ dalam minimal 2 kunci berbeda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرب على سلم %@ في مفتاحين مختلفين على الأقل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在至少 2 个不同调上练习 %@ 音阶。"
          }
        }
      }
    },
