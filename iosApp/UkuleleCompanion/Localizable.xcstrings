        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्यून ज़ोन को ±6 सेंट से ±2 सेंट तक सख्त करता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempersempit zona pas dari ±6 sen menjadi ±2 sen"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe la zona di accordatura da ±6 centesimi a ±2 centesimi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チューニングの許容範囲を±6セントから±2セントに狭めます"
