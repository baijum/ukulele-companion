    "chord_subs_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلم كيفية استبدال الأوتار ببدائل تخلق ألواناً وأمزجة مختلفة مع الحفاظ على المنطق التوافقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahre, wie du Akkorde durch Alternativen ersetzen kannst, die andere Farben und Stimmungen erzeugen und dabei harmonisch sinnvoll bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn how to replace chords with alternatives that create different colors and moods while maintaining harmonic sense."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende cómo reemplazar acordes con alternativas que crean diferentes colores y estados de ánimo manteniendo el sentido armónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprenez à remplacer des accords par des alternatives qui créent différentes couleurs et atmosphères tout en conservant le sens harmonique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीखें कि हार्मोनिक समझ बनाए रखते हुए विभिन्न रंग और मूड बनाने वाले विकल्पों से कॉर्ड कैसे बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelajari cara mengganti akor dengan alternatif yang menciptakan warna dan suasana berbeda sambil menjaga keharmonisan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impara a sostituire gli accordi con alternative che creano colori e atmosfere diverse mantenendo il senso armonico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和声的なまとまりを保ちながら、異なる色合いや雰囲気を生み出す代替コードの使い方を学びましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화성적 흐름을 유지하면서 다른 색채와 분위기를 만들어내는 코드 대체 방법을 배워 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer hoe je akkoorden vervangt door alternatieven die andere kleuren en stemmingen creëren met behoud van harmonische zin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naucz się zastępować akordy alternatywami, które tworzą inne kolory i nastroje, zachowując sens harmoniczny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprenda como substituir acordes por alternativas que criam diferentes cores e climas mantendo o sentido harmônico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнайте, как заменять аккорды альтернативами, создающими другие цвета и настроения при сохранении гармонического смысла."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armonik anlam koruyarak farklı renkler ve atmosferler yaratan alternatiflerle akorları nasıl değiştireceğinizi öğrenin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学习如何用替代和弦创造不同的色彩和情绪，同时保持和声感觉。"
          }
        }
      }
    },
