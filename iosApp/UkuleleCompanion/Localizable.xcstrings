          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj filtra podświetlania, aby znaleźć wszystkie pozycje nuty"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライトフィルターで特定の音のすべてのポジションを確認できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 필터로 특정 음의 모든 위치를 찾을 수 있습니다"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नोट की सभी स्थितियाँ खोजने के लिए हाइलाइट फ़िल्टर उपयोग करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan filter sorot untuk menemukan semua posisi sebuah not"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم فلتر الإبراز للعثور على جميع مواضع نوتة"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用高亮筛选器查找一个音符的所有位置"
          }
        }
      }
    },
    "note_map_tip_3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fret 12 is the same notes as fret 0 (one octave higher)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La frette 12 donne les mêmes notes que la frette 0 (une octave plus haut)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bund 12 hat die gleichen Noten wie Bund 0 (eine Oktave höher)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El traste 12 tiene las mismas notas que el traste 0 (una octava más arriba)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto 12 ha le stesse note del tasto 0 (un'ottava più alta)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O traste 12 tem as mesmas notas que o traste 0 (uma oitava acima)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fret 12 heeft dezelfde noten als fret 0 (één octaaf hoger)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лад 12 — те же ноты, что и лад 0 (на октаву выше)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perde 12, perde 0 ile aynı notalardır (bir oktav yukarıda)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próg 12 ma te same nuty co próg 0 (o oktawę wyżej)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレット12はフレット0と同じ音です（1オクターブ高い）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프렛 12는 프렛 0과 같은 음입니다 (한 옥타브 높음)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्रेट 12 के नोट फ्रेट 0 जैसे ही हैं (एक ऑक्टेव ऊपर)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fret 12 memiliki not yang sama dengan fret 0 (satu oktaf lebih tinggi)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحنق 12 يحمل نفس نوتات الحنق 0 (أعلى بأوكتاف)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 12 品的音符与第 0 品相同（高一个八度）"
          }
        }
      }
    },
    "note_map_tip_4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Low-G to see how the G string changes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez en Sol grave pour voir comment la corde Sol change"
          }
        },
