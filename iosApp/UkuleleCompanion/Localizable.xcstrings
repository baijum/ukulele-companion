    "routine_theory_check_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن أسئلة النظرية لتعزيز معرفتك. استهدف متتالية 5 أسئلة!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte Theoriefragen, um dein Wissen zu festigen. Ziel: eine 5er-Serie!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer theory questions to reinforce your knowledge. Aim for a 5-question streak!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde preguntas de teoría para reforzar tus conocimientos. ¡Intenta una racha de 5!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à des questions de théorie pour renforcer vos connaissances. Visez une série de 5 !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ज्ञान को मजबूत करने के लिए थ्योरी प्रश्नों के उत्तर दें। 5-प्रश्न स्ट्रीक का लक्ष्य रखें!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab pertanyaan teori untuk memperkuat pengetahuan. Target beruntun 5 pertanyaan!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi a domande di teoria per rafforzare le tue conoscenze. Obiettivo: una serie di 5 domande!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "理論問題に答えて知識を強化。5問連続正解を目指す！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이론 문제에 답해 지식을 다지세요. 5문제 연속 정답을 목표로 하세요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord theorievragen om je kennis te versterken. Streef naar een reeks van 5 vragen!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiadaj na pytania z teorii, aby utrwalić wiedzę. Cel: seria 5 pytań!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda a perguntas de teoria para reforçar o seu conhecimento. Objetivo: sequência de 5 perguntas!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечайте на вопросы теории для закрепления знаний. Цель — серия из 5 правильных ответов!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilginizi pekiştirmek için teori sorularını cevaplayın. 5 soruluk seri hedefleyin!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答乐理问题巩固知识。争取连续答对 5 题！"
          }
        }
      }
    },
