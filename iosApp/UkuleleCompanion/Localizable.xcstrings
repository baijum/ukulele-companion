        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी कॉर्ड के लिए गर्दन पर कॉर्ड इन्वर्शन बजाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainkan inversi akor ke atas leher untuk akor apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona rivolti di accordi lungo la tastiera per qualsiasi accordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のコードの転回形をネック上で弾く。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 코드나 전위형을 넥 위로 연주하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel akkoordomkeringen langs de hals voor elk akkoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graj przewroty akordów w górę gryfu dla dowolnego akordu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
