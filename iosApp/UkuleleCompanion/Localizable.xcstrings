    "routine_warmup_advanced_1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحمِ بالسلم الكبير في 3 مواضع مختلفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wärme dich mit der Dur-Tonleiter in 3 verschiedenen Positionen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm up with the major scale in 3 different positions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calienta con la escala mayor en 3 posiciones diferentes."
          }
        },
