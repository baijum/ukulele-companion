    "help_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any feature to learn more about how it works."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une fonctionnalité pour en savoir plus sur son fonctionnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Funktion, um mehr darüber zu erfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier función para saber más sobre cómo funciona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una funzione per saperne di più sul suo funzionamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer recurso para saber mais sobre como funciona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een functie om meer te leren over hoe het werkt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на любую функцию, чтобы узнать, как она работает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl çalıştığını öğrenmek için herhangi bir özelliğe dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij funkcji, aby dowiedzieć się więcej o jej działaniu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各機能をタップして詳しく知りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능을 탭하여 자세히 알아보세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी सुविधा पर टैप करें और जानें कि यह कैसे काम करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk fitur apa pun untuk mempelajari cara kerjanya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أي ميزة لمعرفة كيفية عملها."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击任意功能了解其使用方法。"
          }
        }
      }
    },
