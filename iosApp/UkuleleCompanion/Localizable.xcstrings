    "mic_permission_denied_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tuner cannot work without microphone access. Please enable it in your device's app settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accordeur ne peut pas fonctionner sans accès au microphone. Veuillez l'activer dans les paramètres de l'application sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stimmgerät funktioniert ohne Mikrofonzugriff nicht. Bitte aktiviere ihn in den App-Einstellungen deines Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El afinador no puede funcionar sin acceso al micrófono. Por favor, actívalo en los ajustes de la aplicación de tu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accordatore non può funzionare senza l'accesso al microfono. Abilitalo nelle impostazioni dell'app sul tuo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O afinador não pode funcionar sem acesso ao microfone. Por favor, ative-o nas configurações do aplicativo no seu dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het stemapparaat kan niet werken zonder microfoontoegang. Schakel deze in via de app-instellingen van je apparaat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тюнер не может работать без доступа к микрофону. Пожалуйста, включите его в настройках приложения на вашем устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akort cihazı mikrofon erişimi olmadan çalışamaz. Lütfen cihazınızın uygulama ayarlarından etkinleştirin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuner nie może działać bez dostępu do mikrofonu. Włącz go w ustawieniach aplikacji na swoim urządzeniu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスなしではチューナーは動作しません。端末のアプリ設定でマイクを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 없이는 튜너를 사용할 수 없습니다. 기기의 앱 설정에서 마이크를 활성화해 주세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्यूनर माइक्रोफ़ोन एक्सेस के बिना काम नहीं कर सकता। कृपया अपने डिवाइस की ऐप सेटिंग्स में इसे सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuner tidak dapat berfungsi tanpa akses mikrofon. Silakan aktifkan di pengaturan aplikasi perangkat Anda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للموالف العمل بدون الوصول إلى الميكروفون. يرجى تمكينه في إعدادات التطبيق على جهازك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调音器无法在没有麦克风权限的情况下工作。请在设备的应用设置中启用该权限。"
          }
        }
      }
    },
