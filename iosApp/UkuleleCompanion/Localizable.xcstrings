    "challenge_learn_chord_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find and practice the %@ chord. Try all voicings!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez et pratiquez l'accord %@. Essayez tous les doigtés !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde und übe den Akkord %@. Probiere alle Griffweisen!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca y practica el acorde %@. ¡Prueba todas las digitaciones!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova e pratica l'accordo %@. Prova tutte le voci!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar e praticar o acorde %@. Experimente todos os voicings!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind en oefen het %@ akkoord. Probeer alle grepen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите и отработайте аккорд %@. Попробуйте все варианты!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akorunu bulun ve çalışın. Tüm pozisyonları deneyin!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź i ćwicz akord %@. Wypróbuj wszystkie prowadzenia głosów!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@コードを見つけて練習。すべてのボイシングを試してみよう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 코드를 찾아 연습하세요. 모든 보이싱을 시도해 보세요!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कॉर्ड ढूँढें और अभ्यास करें। सभी वॉइसिंग आज़माएँ!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan dan latih akor %@. Coba semua voicing!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على وتر %@ وتدرب عليه. جرّب جميع التوزيعات الصوتية!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到并练习 %@ 和弦。试试所有指法！"
          }
        }
      }
    },
