    "circle_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على مفتاح لرؤية دلالته وأوتاره. المفاتيح المجاورة مرتبطة ارتباطاً وثيقاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Tonart, um Vorzeichen und Akkorde zu sehen. Benachbarte Tonarten sind eng verwandt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a key to see its signature and chords. Adjacent keys are closely related."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una tonalidad para ver su armadura y acordes. Las tonalidades adyacentes están estrechamente relacionadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une tonalité pour voir son armure et ses accords. Les tonalités adjacentes sont proches."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुंजी हस्ताक्षर और कॉर्ड देखने के लिए कोई कुंजी टैप करें। आसपास की कुंजियाँ निकट संबंधित हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk kunci untuk melihat tanda kunci dan akornya. Kunci yang berdekatan saling terkait erat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una tonalità per vederne l'armatura e gli accordi. Le tonalità adiacenti sono strettamente correlate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーをタップして調号とコードを確認。隣接するキーは近親調です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 탭하여 조표와 코드를 확인하세요. 인접한 키는 가까운조입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een toonsoort om de toonsoortaanduiding en akkoorden te zien. Aangrenzende toonsoorten zijn nauw verwant."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij tonacji, aby zobaczyć jej znaki przykluczowe i akordy. Sąsiednie tonacje są blisko spokrewnione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma tonalidade para ver sua armadura e acordes. As tonalidades adjacentes são próximas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на тональность, чтобы увидеть её знаки и аккорды. Соседние тональности тесно связаны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donanımını ve akorlarını görmek için bir tona dokunun. Komşu tonlar yakın ilişkilidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击一个调查看其调号和和弦。相邻的调是近关系调。"
          }
        }
      }
    },
