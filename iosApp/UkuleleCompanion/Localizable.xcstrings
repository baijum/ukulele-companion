    "chord_transition_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice switching between two chords in time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînez-vous à passer d'un accord à l'autre en rythme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe den Wechsel zwischen zwei Akkorden im Takt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica el cambio entre dos acordes a tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati nel passaggio tra due accordi a tempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique a mudança entre dois acordes no tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen het wisselen tussen twee akkoorden op maat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйте переключение между двумя аккордами в ритме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki akor arasında tempoda geçiş yapma pratiği."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz przełączanie między dwoma akordami w tempie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのコード間の切り替えをリズムに合わせて練習しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박자에 맞춰 두 코드 사이의 전환을 연습하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो कॉर्ड के बीच समय पर बदलने का अभ्यास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlatih berganti antara dua akor sesuai tempo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرن على التبديل بين وترين في الوقت المحدد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按节拍练习两个和弦之间的切换。"
          }
        }
      }
    },
