    "voice_leading_tip_plural": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Keep your fingers on the %1$@ strings — same note in both chords."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Gardez vos doigts sur les cordes %1$@ — même note dans les deux accords."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Lass deine Finger auf den %1$@-Saiten — gleiche Note in beiden Akkorden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Mantén los dedos en las cuerdas %1$@ — misma nota en ambos acordes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: Tieni le dita sulle corde %1$@ — stessa nota in entrambi gli accordi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Mantenha os dedos nas cordas %1$@ — mesma nota nos dois acordes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Houd je vingers op de %1$@ snaren — dezelfde noot in beide akkoorden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: держите пальцы на струнах %1$@ — та же нота в обоих аккордах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Parmaklarınızı %1$@ tellerinde tutun — her iki akorda da aynı nota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Trzymaj palce na strunach %1$@ — ta sama nuta w obu akordach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント: %1$@弦の指はそのまま — 両方のコードで同じ音です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: %1$@현의 손가락은 그대로 유지하세요 — 두 코드 모두 같은 음입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: %1$@ तारों पर उँगलियाँ रखें — दोनों कॉर्ड में एक ही नोट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: Pertahankan jari Anda pada senar %1$@ — not yang sama di kedua akor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلميح: أبقِ أصابعك على أوتار %1$@ — نفس النوتة في كلا الوترين."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示: 保持手指在 %1$@ 弦上——两个和弦使用相同的音。"
          }
        }
      }
    },
