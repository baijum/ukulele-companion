    "note_map_tip_2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the highlight filter to find all positions of a note"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le filtre de mise en évidence pour trouver toutes les positions d'une note"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende den Hervorhebungsfilter, um alle Positionen einer Note zu finden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el filtro de resaltar para encontrar todas las posiciones de una nota"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il filtro evidenziazione per trovare tutte le posizioni di una nota"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o filtro de destaque para encontrar todas as posições de uma nota"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het markeringsfilter om alle posities van een noot te vinden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте фильтр выделения, чтобы найти все позиции ноты"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
