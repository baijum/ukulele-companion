    "settings_precision_mode_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tightens the in-tune zone from ±6 cents to ±2 cents"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit la zone d'accordage de ±6 cents à ±2 cents"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verengt den gestimmten Bereich von ±6 Cent auf ±2 Cent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la zona de afinación de ±6 cents a ±2 cents"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringe la zona di accordatura da ±6 centesimi a ±2 centesimi"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz a zona de afinação de ±6 cents para ±2 cents"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleint de gestemd-zone van ±6 cent naar ±2 cent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сужает зону настройки с ±6 центов до ±2 центов"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akort bölgesini ±6 sentten ±2 sente daraltır"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawęża strefę nastrojenia z ±6 centów do ±2 centów"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューニングの許容範囲を±6セントから±2セントに狭めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튜닝 허용 범위를 ±6센트에서 ±2센트로 좁힙니다"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्यून ज़ोन को ±6 सेंट से ±2 सेंट तक सख्त करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempersempit zona pas dari ±6 sen menjadi ±2 sen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيّق نطاق الضبط من ±6 سنت إلى ±2 سنت"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将调准范围从 ±6 音分缩小到 ±2 音分"
          }
        }
      }
    },
